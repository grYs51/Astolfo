ARG NODE_VERSION=23

FROM node:${NODE_VERSION}-alpine AS build

WORKDIR /usr/src/app

RUN apk add --no-cache openssl

COPY .yarnrc.yml ./
COPY .yarn ./.yarn
COPY package.json yarn.lock ./
COPY ./libs/models/prisma ./prisma

RUN yarn install

COPY . .

RUN yarn prisma generate \
  && npx nx build bot \
  && rm -rf /usr/src/app/apps/bot/src


# runtime image
FROM node:${NODE_VERSION}-alpine

RUN apk add --no-cache tini dumb-init \
  && corepack enable && corepack prepare yarn@1.22.22 --activate

ENV NODE_ENV=production

WORKDIR /usr/src/app

COPY .yarnrc.yml ./
COPY .yarn ./.yarn
COPY package.json yarn.lock ./


RUN yarn workspaces focus --production \
  && yarn cache clean

COPY --chown=node:node --from=build /usr/src/app/dist/apps/bot ./dist
COPY --chown=node:node --from=build /usr/src/app/prisma ./prisma
COPY --chown=node:node --from=build /usr/src/app/node_modules/.prisma/client ./node_modules/.prisma/client

EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
# `yarn prisma`, not `npx prisma`: the CLI is a real dependency now, so it is
# in this image and runs pinned and offline. npx resolved nothing locally and
# downloaded whatever npm tags `latest` on every boot — currently the 8.0.0 RC,
# driving migrations against a 6.x client.
CMD ["sh", "-c", "yarn prisma migrate deploy && node dist/index.js"]
