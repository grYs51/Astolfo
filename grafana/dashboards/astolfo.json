{
  "uid": "astolfo-bot",
  "title": "Astolfo bot",
  "tags": ["astolfo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Bot scrape up",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "up{group=\"astolfo\"}" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 2, "type": "stat", "title": "Uptime",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "time() - process_start_time_seconds{group=\"astolfo\"}" }],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3, "type": "stat", "title": "Cached statuses",
      "gridPos": { "x": 8, "y": 0, "w": 16, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "discord_bot_cached_status_total", "legendFormat": "{{status}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value_and_name" }
    },
    {
      "id": 4, "type": "timeseries", "title": "Gateway events per minute",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (eventName) (rate(discord_bot_events_total[$__rate_interval])) * 60", "legendFormat": "{{eventName}}" }],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 20 } } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Cached statuses over time",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "discord_bot_cached_status_total", "legendFormat": "{{status}}" }]
    },
    {
      "id": 6, "type": "bargauge", "title": "Slash commands (selected range)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sort_desc(round(sum by (slashName) (increase(discord_bot_slash_total[$__range]))))", "legendFormat": "{{slashName}}", "instant": true }],
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7, "type": "bargauge", "title": "Prefix commands (selected range)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sort_desc(round(sum by (commandName) (increase(discord_bot_commands_total[$__range]))))", "legendFormat": "{{commandName}}", "instant": true }],
      "options": { "orientation": "horizontal", "displayMode": "basic", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Memory",
      "gridPos": { "x": 0, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes{group=\"astolfo\"}", "legendFormat": "RSS" },
        { "refId": "B", "expr": "nodejs_heap_size_used_bytes{group=\"astolfo\"}", "legendFormat": "Heap used" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "CPU",
      "gridPos": { "x": 8, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(process_cpu_seconds_total{group=\"astolfo\"}[$__rate_interval])", "legendFormat": "CPU" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Event loop lag (p99)",
      "gridPos": { "x": 16, "y": 20, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "nodejs_eventloop_lag_p99_seconds{group=\"astolfo\"}", "legendFormat": "p99" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
