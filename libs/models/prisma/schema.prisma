generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model guild_configs {
  guild_id            String    @id @db.VarChar
  prefix              String    @default("!") @db.VarChar
  welcome_channel_id  String?   @db.VarChar
  welcome_message     String    @default("Welcome @member") @db.VarChar(200)
  goodbye_message     String    @default("") @db.VarChar(200)
  toggles             Int       @default(0)
  /// Weekly digest: channel to post in (null = off) and when it last posted
  digest_channel_id   String?   @db.VarChar
  digest_last_sent_at DateTime? @db.Timestamp(6)
  /// Channel for level-up posts (null = off)
  level_up_channel_id String?   @db.VarChar
}

model voice_stats {
  id         String   @id @default(uuid()) @db.VarChar
  guild_id   String   @db.VarChar
  member_id  String   @db.VarChar
  channel_id String   @db.VarChar
  type       String   @db.VarChar
  issued_on  DateTime  @db.Timestamp(6)
  // NULL = session still open (persist-on-open); closed with the leave
  // timestamp, or by crash recovery at startup
  ended_on   DateTime? @db.Timestamp(6)

  // No standalone [guild_id] index: it's the leftmost prefix of the
  // composite indexes below
  @@index([guild_id, member_id])
  @@index([guild_id, type])
  @@index([guild_id, issued_on])
  @@index([member_id])
}

model user_statuses {
  id         String    @id @default(uuid()) @db.VarChar
  user_id    String    @db.VarChar
  status     String    @db.VarChar
  created_at DateTime  @db.Timestamp(6)
  // NULL = status still current (persist-on-open, like voice_stats); closed
  // on the next status change, on shutdown, or by crash recovery at startup
  ended_at   DateTime? @db.Timestamp(6)

  // Dashboard queries ask for rows still running after a date:
  // (ended_at > x OR ended_at IS NULL)
  @@index([user_id, ended_at])
}

model user_activities {
  id          String   @id @default(uuid()) @db.VarChar
  user_id     String   @db.VarChar
  activity_id String   @db.VarChar
  created_at  DateTime @db.Timestamp(6)
  ended_at    DateTime @db.Timestamp(6)
}

model message_stats {
  id         String   @id @default(uuid()) @db.VarChar
  guild_id   String   @db.VarChar
  channel_id String   @db.VarChar
  created_at DateTime @default(now()) @db.Timestamp(6)
  message_id String   @db.VarChar
  user_id    String   @db.VarChar

  @@index([guild_id, user_id])
  @@index([guild_id, created_at])
}

model user_configs {
  user_id String  @id @db.VarChar
  mw_id   String? @unique @db.VarChar
}

model metrics {
  created_at DateTime @default(now()) @db.Timestamp(6)
  jsonb      Json
  updated_at DateTime @default(now()) @db.Timestamp(6)
  id         Int      @id @default(autoincrement())
}

model game_type {
  id           String        @id
  name         String        @unique
  game_results game_result[]
}

model game_result {
  id           String        @id @default(uuid()) @db.VarChar
  game_type_id String
  guild_id     String
  created_at   DateTime      @default(now())
  metadata     Json?
  players      game_player[]
  game_type    game_type     @relation(fields: [game_type_id], references: [id])
}

model game_player {
  id             String      @id @default(uuid()) @db.VarChar
  game_result_id String
  user_id        String
  result         Int          // 0 = loss, 1 = win, 2 = tie
  move           String?
  game_result    game_result @relation(fields: [game_result_id], references: [id])
}

model session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}

// The Discord profile saved at login, which /auth/status returns. The OAuth
// tokens are not stored: nothing calls Discord on the user's behalf.
model user_session {
  id            String    @id
  username      String
  global_name   String?
  avatar        String?
  // NULL for users who logged in before these were tracked
  created_at    DateTime? @db.Timestamp(6)
  last_login_at DateTime? @db.Timestamp(6)
}

/// Each `discord_*` counter's running total at the end of a UTC day (the last
/// metrics snapshot that day). A day's usage is its total minus the day before.
model metric_daily {
  day   DateTime @db.Date
  name  String   @db.VarChar
  label String   @db.VarChar
  value BigInt

  @@id([day, name, label])
}

/// The bot joining or leaving a server (GuildCreate / GuildDelete)
model guild_events {
  id       String   @id @default(uuid()) @db.VarChar
  guild_id String   @db.VarChar
  type     String   @db.VarChar // 'join' | 'leave'
  at       DateTime @default(now()) @db.Timestamp(6)

  @@index([at])
}

/// Saves on the dashboard settings page: who changed what in a guild's settings
model guild_settings_changes {
  id       String   @id @default(uuid()) @db.VarChar
  guild_id String   @db.VarChar
  user_id  String   @db.VarChar
  at       DateTime @default(now()) @db.Timestamp(6)
  /// [{ field, from, to }]
  changes  Json

  @@index([guild_id, at])
}

/// Dashboard page views: the route pattern (never the URL), per user and UTC day
model page_views {
  day     DateTime @db.Date
  path    String   @db.VarChar(100)
  user_id String   @db.VarChar
  views   Int      @default(1)

  @@id([day, path, user_id])
}

/// The owner's maintenance notice, shown as a banner on every dashboard page. One row (id 1) or none.
model app_notice {
  id         Int      @id @default(1)
  text       String   @db.VarChar(300)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
}

/// The XP ledger: one row per grant. `key` names what earned it, so every grant is idempotent.
model xp_events {
  id         String   @id @default(uuid()) @db.VarChar
  guild_id   String   @db.VarChar
  member_id  String   @db.VarChar
  /// VOICE | STARTER | RECONNECT | WELCOME | MILESTONE | WEEKLY | MESSAGE | STREAK | GAME
  source     String   @db.VarChar
  amount     Int
  note       String   @db.VarChar
  /// VOICE rows only: the multiplier step line for the session chart
  segments   Json?
  key        String   @unique @db.VarChar
  /// When it was earned
  created_at DateTime @db.Timestamp(6)

  @@index([guild_id, member_id])
}

/// The owner's XP rules from /admin. One row (id 1) or none (= the defaults in code).
model xp_rules {
  id         Int      @id @default(1)
  rules      Json
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
}
